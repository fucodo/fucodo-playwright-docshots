# Copy to .env (never commit .env). Any OpenAI-compatible API with image input works.
DOCSHOTS_AI_BASE_URL=https://api.openai.com/v1
DOCSHOTS_AI_API_KEY=sk-...
DOCSHOTS_AI_MODEL=gpt-4o
# DOCSHOTS_AI_JSON_MODE=false        # if the server rejects response_format
# DOCSHOTS_AI_MAX_IMAGE_SIDE=2000

# Local mock for trying it out (node app/mock-ai.cjs):
# DOCSHOTS_AI_BASE_URL=http://127.0.0.1:4318/v1
# DOCSHOTS_AI_API_KEY=test
# DOCSHOTS_AI_MODEL=mock-vision

# Persona passwords
DOCSHOT_PW_SCHOOLADMIN=secret-doc-schooladmin
